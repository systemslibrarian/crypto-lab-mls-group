{
  "name": "crypto-lab-mls-group",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Interactive MLS group messaging demonstration with TreeKEM, cryptographic key schedule, and RFC 9420 compliance",
  "homepage": "https://systemslibrarian.github.io/crypto-lab-mls-group/",
  "repository": {
    "type": "git",
    "url": "https://github.com/systemslibrarian/crypto-lab-mls-group.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run test:publish-request && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:a11y": "playwright test",
    "deploy": "gh workflow run deploy.yml --repo systemslibrarian/crypto-lab-mls-group --ref main",
    "test:publish-request": "node --test tests/publish-request.node.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "typescript": "~5.7.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0"
  }
}
